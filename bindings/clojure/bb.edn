;; Run from bindings/clojure; the tests read the golden fixtures at
;; ../../fixtures. The binding itself comes in through its own deps.edn.
{:paths ["test"]
 :deps {io.github.miniforge-ai/miniforge-app-foundation {:local/root "."}}
 :tasks
 {test {:doc "Validate every golden fixture against the Malli mirror."
        :requires ([clojure.test :as t]
                   [ai.miniforge.workbench-contract.schema-test])
        :task (let [{:keys [fail error]} (t/run-tests 'ai.miniforge.workbench-contract.schema-test)]
                (when (pos? (+ fail error))
                  (throw (ex-info "Clojure binding tests failed" {:fail fail :error error}))))}}}
